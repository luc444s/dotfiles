# Unified shell config — works on Termux (Android) and GNU/Linux.
# Installed by install.sh; do not edit in place.

case $- in
  *i*) ;;
  *) return ;;
esac

# ---- Platform detection -----------------------------------------------------
# $PREFIX is set only on Termux (/data/data/com.termux/files/usr)
IS_TERMUX=""
[ -n "$PREFIX" ] && [ -d "$PREFIX/bin" ] && IS_TERMUX=1

export TERM=xterm-256color
export COLORTERM=truecolor
export EDITOR=vim
export VISUAL=vim

# Disable cursor blink
printf '\e[?12l' >/dev/tty 2>/dev/null || true

# Ocultar cursor de Termux dentro de tmux (lo maneja la app activa)
if [ -n "$TMUX" ] && [ -n "$IS_TERMUX" ]; then
  printf '\e[?25l' 2>/dev/null
fi

alias ls='ls --color=auto'
alias ll='ls -lah'
alias la='ls -A'
alias grep='grep --color=auto'

if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b 2>/dev/null)"
fi

if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
  prompt_host=""
else
  prompt_host="\\h"
fi

termux_prompt() {
  local branch
  local venv_name
  branch=$(git branch --show-current 2>/dev/null)
  if [ -n "$VIRTUAL_ENV" ]; then
    venv_name="\[\e[1;33m\]($(basename "$VIRTUAL_ENV"))\[\e[0m\] "
  else
    venv_name=""
  fi
  if [ -n "$branch" ]; then
    PS1='${debian_chroot:+($debian_chroot)}'"$venv_name"'\[\e[1;35m\]\u@\[\e[1;36m\]'\"$prompt_host\"'\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;90m\](\[\e[1;35m\]'"$branch"'\[\e[1;90m\])\[\e[0m\]\n\[\e[1;35m\]> \[\e[0m\]'
  else
    PS1='${debian_chroot:+($debian_chroot)}'"$venv_name"'\[\e[1;35m\]\u@\[\e[1;36m\]'\"$prompt_host\"'\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\]\n\[\e[1;35m\]> \[\e[0m\]'
  fi
}

if [ -n "$force_color_prompt" ] || [ -t 1 ]; then
  PROMPT_COMMAND="termux_prompt; printf '\e[?12l'"
else
  PS1='\u@\h:\w\$ '
fi

export LESS='-R'

# ---- Per-host overrides (user PATH, project dirs, aliases) ------------------
# Source $HOME/.bashrc.local if present. Edit THAT file, never this one.
# Cross-platform way to inject Termux/Linux-specific bits.
if [ -r "$HOME/.bashrc.local" ]; then
  . "$HOME/.bashrc.local"
fi

# ---- Auto-activate Python venv per project ----------------------------------
# Define PROJECT_DIRS / PROJECT_VENVS here OR in .bashrc.local.
PROJECT_DIRS=${PROJECT_DIRS:-}
PROJECT_VENVS=${PROJECT_VENVS:-}

_activate_project_venv() {
  local i
  local project_dir
  local venv_path

  if [ -z "$PROJECT_DIRS" ]; then
    return
  fi

  for i in "${!PROJECT_DIRS[@]}"; do
    project_dir="${PROJECT_DIRS[$i]}"
    venv_path="${PROJECT_VENVS[$i]}"

    case "$PWD/" in
      "$project_dir"/*|"$project_dir/")
        if [ "$VIRTUAL_ENV" = "$venv_path" ]; then
          return
        fi

        if [ -n "$VIRTUAL_ENV" ] && [ "$AUTO_PROJECT_VENV" = "1" ]; then
          deactivate 2>/dev/null
        fi

        if [ -f "$venv_path/bin/activate" ]; then
          AUTO_PROJECT_VENV=1
          export AUTO_PROJECT_VENV
          . "$venv_path/bin/activate"
        fi
        return
        ;;
    esac
  done

  if [ -n "$VIRTUAL_ENV" ] && [ "$AUTO_PROJECT_VENV" = "1" ]; then
    deactivate 2>/dev/null
    unset AUTO_PROJECT_VENV
  fi
}

cd() {
  builtin cd "$@" && _activate_project_venv
}

pushd() {
  builtin pushd "$@" && _activate_project_venv
}

popd() {
  builtin popd "$@" && _activate_project_venv
}

# Activar si ya estamos en el directorio
_activate_project_venv

# ---- tmux wrapper: attach to last session if exists -------------------------
if command -v zellij >/dev/null 2>&1; then
  zellij() {
    [ -n "$ZELLIJ" ] && return
    local latest
    latest=$(\command zellij list-sessions -s -r 2>/dev/null | head -1)
    if [ -n "$latest" ]; then
      \command zellij attach -f "$latest"
    else
      \command zellij
    fi
  }
fi

# ---- Termux-only extras -----------------------------------------------------
if [ -n "$IS_TERMUX" ]; then
  alias dumpsys='adb -s localhost:5555 shell dumpsys'
  alias tty-clock='tty-clock -s -C 6'
  termux-wake-lock >/dev/null 2>&1 || true
fi
